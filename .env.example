# Copy this file to ".env" and fill in your project's real values.
# Get these from: Supabase Dashboard -> Project Settings -> API
#
# VITE_SUPABASE_URL is your project URL, e.g. https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY is the "anon" / "publishable" key — safe to
# expose in a browser bundle, but should still be config, not hardcoded,
# so it can differ per environment and be rotated without a code change.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
